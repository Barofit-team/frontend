# API 서버 주소. 휴대폰(Expo Go)에서 접속하므로 localhost가 아니라 PC의 Wi-Fi IP를 넣습니다 (예: http://192.168.0.7:3002)
EXPO_PUBLIC_API_URL=

# 소셜 로그인 공개 키(비밀값 아님). 백엔드와 같은 콘솔의 값을 씁니다
# 카카오: REST API 키 / 구글: 웹 클라이언트 ID
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# 소셜 로그인 redirect_uri. 콘솔과 백엔드(SOCIAL_REDIRECT_URIS)에 등록된 값과 같아야 합니다(생략 시 기본값)
EXPO_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:8081
